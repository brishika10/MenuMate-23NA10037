# Copy to .env and fill in. Never put a real key in any file you submit.
# Reviewers run your code with their own values for these three variables, so read the settings only from here.
LLM_API_KEY=
# OpenAI endpoint (used for development). Any OpenAI-compatible provider works, e.g. Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1
# Exact model name used is recorded in README.md.
LLM_MODEL=gpt-4o-mini
